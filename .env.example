# Server-side GitHub access. Optional for public repositories; improves rate limits.
GITHUB_TOKEN=

# Frontend development proxy and server defaults
PORT=4000

# Free-first default. Provider keys stay server-side and must never enter VITE_* variables.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

XAI_API_KEY=
XAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional client tuning for the legacy direct fallback path
VITE_GITHUB_API_URL=https://api.github.com
VITE_GITHUB_TIMEOUT_MS=6500
